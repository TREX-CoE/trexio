prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@TREXIO_PC_LIBDIR@
includedir=@TREXIO_PC_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ltrexio
Libs.private: @TREXIO_PC_LIBS_PRIVATE@
Requires.private: @TREXIO_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir}

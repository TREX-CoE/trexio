# =============== PYTHON API =============== #

# SWIG output, generated in maintainer mode and shipped in the distribution.
pytrexio_c    = src/pytrexio_wrap.c
pytrexio_py   = src/pytrexio.py
trexio_py     = src/trexio.py
pytrexio_i    = src/pytrexio.i
numpy_i       = src/numpy.i

TEST_PY       = python/test/test_api.py python/test/test_memory.py

# Distributed unconditionally, so that a tarball made without --enable-python
# can still be configured with it.
EXTRA_DIST += $(pytrexio_c) $(pytrexio_py) $(trexio_py) $(pytrexio_i) $(numpy_i) \
              pyproject.toml \
              python/README.md \
              python/requirements.txt \
              python/pytrexio/__init__.py \
              python/pytrexio/_version.py \
              python/test/benzene_data.py \
              python/test/conftest.py \
              $(TEST_PY)

if HAVE_PYTHON

# The extension module is compiled from the SWIG wrapper and linked against the
# TREXIO library built here, rather than compiling a second copy of it as the
# wheel build used to.
#
# Everything goes into one importable package, so that `import trexio` pulls in
# a single directory rather than a module beside a second package. The package
# carries a compiled extension, so it is installed into the platform-specific
# directory: where pythondir and pyexecdir differ (lib versus lib64), a regular
# package split across the two cannot be imported at all, and this also keeps
# the API under a single PYTHONPATH entry.
trexiodir     = $(pyexecdir)/trexio
trexioexecdir = $(pyexecdir)/trexio

# The generated API becomes the package's __init__.py. Automake installs a
# _PYTHON file under its own name, so it is staged under the right one first.
trexio-package/__init__.py: $(trexio_py)
	$(MKDIR_P) trexio-package
	cp -f $(srcdir)/$(trexio_py) $@

BUILT_SOURCES += trexio-package/__init__.py

nodist_trexio_PYTHON = trexio-package/__init__.py \
                       python/pytrexio/_version.py \
                       $(pytrexio_py)

trexioexec_LTLIBRARIES       = _pytrexio.la
nodist__pytrexio_la_SOURCES  = $(pytrexio_c)
_pytrexio_la_CPPFLAGS        = $(AM_CPPFLAGS) $(PYTHON_CPPFLAGS) $(NUMPY_CPPFLAGS)
_pytrexio_la_LDFLAGS         = -module -avoid-version -shared
_pytrexio_la_LIBADD          = src/libtrexio.la

# A libtool archive is of no use inside a Python package.
install-exec-hook:
	$(RM) -f -- $(DESTDIR)$(trexioexecdir)/_pytrexio.la

endif

# SWIG writes pytrexio.py alongside the wrapper, and the org generation writes
# trexio.py alongside the header, so neither has a recipe of its own. Say which
# recipe produces them, otherwise a target that names them as a prerequisite
# stops with "No rule to make target" in a checkout where they are absent.
$(pytrexio_py): $(pytrexio_c)
	@:

$(trexio_py): $(trexio_h)
	@:

# pip drives CMake through scikit-build-core, so these targets only have to
# invoke it from the top of the tree. There is no staging step any more: the
# wheel is built from the sources in place rather than from a copy of the
# library under python/.
python-install: $(pytrexio_c) $(pytrexio_py) $(trexio_py)
	python3 -m pip install pytest
	python3 -m pip install $(srcdir) --force-reinstall

python-sdist: $(pytrexio_c) $(pytrexio_py) $(trexio_py)
	python3 -m pip install build
	cd $(srcdir) && python3 -m build --sdist --outdir python/dist

# Stage the freshly built module so that `make check` imports what was just
# compiled, rather than whatever copy of TREXIO happens to be installed on the
# system. The python-install and python-sdist targets do not use this copy: they
# hand the whole tree to pip, which drives CMake and gets its own build.
if HAVE_PYTHON
PYTHON_TEST_PKG = python-test-package

$(PYTHON_TEST_PKG)/trexio/_pytrexio.so: _pytrexio.la
	$(MKDIR_P) $(PYTHON_TEST_PKG)/trexio
	cp -f $(srcdir)/$(trexio_py) $(PYTHON_TEST_PKG)/trexio/__init__.py
	cp -f $(srcdir)/$(pytrexio_py) $(PYTHON_TEST_PKG)/trexio/
	cp -f $(srcdir)/python/pytrexio/_version.py $(PYTHON_TEST_PKG)/trexio/
	cp -f .libs/_pytrexio.so $(PYTHON_TEST_PKG)/trexio/

# Run the Python tests as part of `make check`, but only when pytest is
# available: it is a test-only dependency and not everyone building the library
# will have it.
check-local: $(PYTHON_TEST_PKG)/trexio/_pytrexio.so
	@if $(PYTHON) -c "import pytest" 2>/dev/null ; then \
	  echo "  PYTEST   Python API" ; \
	  PYTHONPATH="$(abs_builddir)/$(PYTHON_TEST_PKG)$${PYTHONPATH:+:$$PYTHONPATH}" \
	    $(PYTHON) -m pytest -v $(PYTEST_FLAGS) $(TEST_PY) ; \
	else \
	  echo "  SKIP     Python API tests (pytest is not installed)" ; \
	fi
	-$(RM) -rf -- __pycache__ python/test/__pycache__
	-$(RM) -rf -- test_file_py.h5 unsafe_test_file_py.h5
	-$(RM) -rf -- test_file_py.dir unsafe_test_file_py.dir
endif

if HAVE_HDF5
PYTEST_FLAGS = --all
else
PYTEST_FLAGS =
endif

if HAVE_HDF5
python-test: $(TEST_PY)
	python3 -m pytest -v --all $(TEST_PY)
	$(RM) -r  -- __pycache__
	$(RM) -f  -- test_file_py.h5 unsafe_test_file_py.h5
	$(RM) -rf -- test_file_py.dir unsafe_test_file_py.dir
else
python-test: $(TEST_PY)
	python3 -m pytest -v $(TEST_PY)
	$(RM) -r  -- __pycache__
	$(RM) -rf -- test_file_py.dir unsafe_test_file_py.dir
endif

.PHONY: python-test python-install python-sdist cppcheck check-numpy FORCE ocaml

# =============== DEVELOPER MODE =============== #

SWIG          = @SWIG@
HDF5_LDFLAGS  = @HDF5_LDFLAGS@
HDF5_CFLAGS   = @HDF5_CFLAGS@
HDF5_CPPFLAGS = @HDF5_CPPFLAGS@

if TREXIO_DEVEL

CLEANFILES += $(SOURCES) $(trexio_h) $(HTML_TANGLED) $(htmlizer) .git_hash

BUILT_SOURCES += $(SOURCES) $(trexio_h)

if HAVE_FORTRAN
CLEANFILES += $(trexio_f)
BUILT_SOURCES += $(trexio_f) $(test_trexio_f)
$(trexio_f): $(trexio_h)
endif

.git_hash: FORCE
	git log | head -1 | cut -d ' ' -f 2 > .git_hash

all: .git_hash

GENERATOR_FILES = $(srcdir)/tools/generator.py \
		  $(srcdir)/tools/generator_tools.py

$(SOURCES): $(trexio_h)
src/trexio.c: $(trexio_h)

trex.json: trex.org
	cd $(srcdir)/tools && ./build_json.sh

# config.h is generated into the build directory, which is not the source
# directory in an object-directory build, so tell the generator where to find it
# instead of letting it fall back to placeholder version and hash values.
$(trexio_h): $(ORG_FILES) $(GENERATOR_FILES) trex.json
	cd $(srcdir)/tools && \
	  TREXIO_CONFIG_H="$(abs_builddir)/include/config.h" ./build_trexio.sh

$(htmlizer): $(ORG_FILES) $(srcdir)/src/README.org
	$(MKDIR_P) docs
	touch $(htmlizer)
	cd $(srcdir)/tools && ./build_doc.sh

cppcheck: cppcheck.out
	cat cppcheck.out

cppcheck.out: $(trexio_h)
	cd src/ && \
	cppcheck -q --error-exitcode=0  \
	  --enable=all \
	  --language=c --std=c99 -rp --platform=unix64  \
	  -I../include *.c *.h 2>../$@

#################
# OCaml binding #
#################

ocaml/trexio/_build/default/lib/trexio.cma:
	$(MAKE) -C ocaml/trexio

ocaml: ocaml/trexio/_build/default/lib/trexio.cma

ocaml-install: ocaml/trexio/_build/default/lib/trexio.cma
	opam install ocaml/trexio

##################
# Python binding #
##################

# Build Python module and C wrapper code for TREXIO using SWIG
$(pytrexio_c): $(ORG_FILES) $(GENERATOR_FILES) $(trexio_h) $(pytrexio_i) $(numpy_i)
	@if [[ $(SWIG).x != ".x" ]] ; then \
	cd $(srcdir)/src/ && \
		$(SWIG) -python -I../include -o pytrexio_wrap.c pytrexio.i ; \
	else echo "Error: SWIG is not installed" ; \
	exit 1 ; \
	fi


$(numpy_i):
	wget https://raw.githubusercontent.com/numpy/numpy/main/tools/swig/numpy.i -O $(numpy_i)

check-numpy:
	cd tools && ./check_numpy_i.sh

# Include files needed to produce the debian package.
DEB_FILES = \
  helpers-debian/changelog     \
  helpers-debian/compat        \
  helpers-debian/control       \
  helpers-debian/copyright     \
  helpers-debian/rules         \
  helpers-debian/source        \
  helpers-debian/libtrexio0.install \
  helpers-debian/libtrexio-dev.install \
  helpers-debian/source        \
  helpers-debian/README.source

debian_from_dist: $(DEB_FILES) $(SOURCES) $(trexio_h)
	cp ../trexio-$(PACKAGE_VERSION).tar.gz ../libtrexio_$(PACKAGE_VERSION).orig.tar.gz
	debuild


# The SWIG output and the staged copies are regenerated from the org sources in
# maintainer mode, so they are cleaned only here and not in a distribution build,
# where they are shipped rather than built.
CLEANFILES += $(pytrexio_c) \
              $(pytrexio_py) \
              $(trexio_py)


endif
